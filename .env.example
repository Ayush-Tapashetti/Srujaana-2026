# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values.   (.env is never committed.)
#   macOS / Linux:   cp .env.example .env
#   Windows:         copy .env.example .env
# ---------------------------------------------------------------------------

# --- AI model (required for checking chats) --------------------------------
# Free key, no card: https://console.groq.com/keys
GROQ_API_KEY=
# A current production model ID from https://console.groq.com/docs/models
# Model IDs are retired regularly. openai/gpt-oss-20b was production at the
# time of writing; openai/gpt-oss-120b is the larger alternative.
GROQ_MODEL=openai/gpt-oss-20b
# Accuracy note: the small default model sometimes misses terms entirely.
# The app has a pattern-based safety net for that, but a larger model reads
# Hinglish far better. If your Groq quota allows, try:
#   GROQ_MODEL=openai/gpt-oss-120b
# then run: docker compose exec server python -m app.check_llm

# --- Fallback model (optional, leave blank) --------------------------------
# Also needs google-genai added to server/requirements.txt.
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Behaviour --------------------------------------------------------------
# Re-use earlier AI answers for the same chat. Set to false for live
# "change an input" drills, so every check really calls the model.
LLM_CACHE_ENABLED=true

# Shows the "Demo: alter one event" button on the Evidence page, and lets the
# API corrupt a stored evidence event. Keep false by default and for anything
# deployed; set to true only on your own machine when you run the demo.
DEMO_TAMPER_ENABLED=false

CONFIRM_LINK_TTL_HOURS=72
MAX_UPLOAD_MB=2

# --- Windows only: uncomment if live reload doesn't pick up your edits -----
# VITE_USE_POLLING=true
# WATCHFILES_FORCE_POLLING=true

# --- Only used when running without Docker ----------------------------------
# Docker always overrides this to point at its own database container.
DATABASE_URL=postgresql+psycopg://handshake:handshake@localhost:5432/handshake
